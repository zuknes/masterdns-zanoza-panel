#!/usr/bin/env bash
# ==============================================================================
# zanoza — Management CLI for Zanoza Panel (Docker or Podman)
# Installed by container-install.sh as /usr/local/bin/zanoza
# ==============================================================================
set -euo pipefail

INSTALL_CONF="/etc/zanoza-panel/install.conf"
LEGACY_MARKER="/etc/zanoza-panel/.docker-install-dir"

# Source common helpers (installed alongside this script, or from repo).
COMMON=""
for d in "$(dirname "$(readlink -f "$0")")" /opt/zanoza-panel/scripts; do
	[ -f "$d/zanoza-common.sh" ] && { COMMON="$d/zanoza-common.sh"; break; }
done
if [ -n "$COMMON" ]; then
	# shellcheck source=./zanoza-common.sh
	. "$COMMON"
else
	die "zanoza-common.sh not found. Repository may be missing — re-run the installer."
fi

# ==========================================================================
# Runtime detection — determine how Zanoza was installed.
# ==========================================================================
detect_install() {
	# 1. install.conf is authoritative.
	if [ -f "$INSTALL_CONF" ]; then
		# shellcheck source=/dev/null
		. "$INSTALL_CONF"
		if [ -z "${CONTAINER_RUNTIME:-}" ] || [ -z "${REPO_DIR:-}" ]; then
			die "install.conf is incomplete. Re-run the installer."
		fi
		[ "${CONTAINER_RUNTIME:-}" = docker ] && COMPOSE_FILE="${COMPOSE_FILE:-$REPO_DIR/docker-compose.yml}"
		return 0
	fi

	# 2. Legacy Docker marker (from old docker-install.sh).
	if [ -f "$LEGACY_MARKER" ]; then
		read -r REPO_DIR <"$LEGACY_MARKER"
		if [ -d "$REPO_DIR" ] && [ -f "$REPO_DIR/docker-compose.yml" ]; then
			CONTAINER_RUNTIME=docker
			COMPOSE_FILE="$REPO_DIR/docker-compose.yml"
			return 0
		fi
	fi

	# 3. Auto-detect: Docker.
	if has_docker 2>/dev/null; then
		for d in /opt/zanoza-panel /opt/masterdns-zanoza-panel; do
			if [ -f "$d/docker-compose.yml" ] && \
				docker compose -f "$d/docker-compose.yml" ps --quiet 2>/dev/null | grep -q .; then
				CONTAINER_RUNTIME=docker
				REPO_DIR="$d"
				COMPOSE_FILE="$d/docker-compose.yml"
				return 0
			fi
		done
	fi

	# 4. Auto-detect: Podman + Quadlet.
	if [ -f /etc/containers/systemd/zanoza-panel.container ] && \
		systemctl is-active --quiet zanoza-panel 2>/dev/null; then
		CONTAINER_RUNTIME=podman
		UNIT_NAME=zanoza-panel
		INSTALL_METHOD=quadlet
		REPO_DIR="$(grep -oP 'EnvironmentFile=\K[^[:space:]]+' /etc/containers/systemd/zanoza-panel.container 2>/dev/null | head -1 | xargs dirname 2>/dev/null || true)"
		[ -z "$REPO_DIR" ] && REPO_DIR="/opt/zanoza-panel"
		return 0
	fi

	# 5. Auto-detect: Podman + generate-systemd.
	if systemctl is-active --quiet container-zanoza-panel 2>/dev/null; then
		CONTAINER_RUNTIME=podman
		UNIT_NAME=container-zanoza-panel
		INSTALL_METHOD=generate-systemd
		REPO_DIR="$(grep -oP 'EnvironmentFile=-\K[^[:space:]]+' /etc/systemd/system/container-zanoza-panel.service 2>/dev/null | head -1 | xargs dirname 2>/dev/null || echo '/opt/zanoza-panel')"
		return 0
	fi

	# 6. Bare-metal install — not managed by this CLI.
	if [ -f /usr/local/bin/zanoza-panel ] && systemctl is-active --quiet zanoza-panel 2>/dev/null; then
		die "This appears to be a bare-metal install. Use the native zanoza CLI instead."
	fi

	die "Could not detect a Zanoza Panel installation. Run the installer first."
}

# ==========================================================================
# Action helpers
# ==========================================================================
show_url() {
	local port="${ZANOZA_PANEL_PORT:-8443}"
	local addr="${ZANOZA_PANEL_ADDR:-0.0.0.0}"
	local path="${ZANOZA_PANEL_PATH:-/admin}"
	local scheme="http"

	ENV_FILE="$REPO_DIR/.env"
	CONFIG_DIR="$REPO_DIR/zanoza-config"
	[ -f "$ENV_FILE" ] && . "$ENV_FILE" 2>/dev/null || true
	port="${ZANOZA_PANEL_PORT:-$port}"
	path="${ZANOZA_PANEL_PATH:-$path}"
	addr="${ZANOZA_PANEL_ADDR:-$addr}"
	[ -f "$CONFIG_DIR/tls.crt" ] && [ -f "$CONFIG_DIR/tls.key" ] && scheme="https"

	local host="$addr"
	if [ "$addr" = "0.0.0.0" ]; then
		host="$(curl -s --max-time 2 ifconfig.me 2>/dev/null || hostname -I 2>/dev/null | awk '{print $1}')"
		[ -z "$host" ] && host="127.0.0.1"
	elif [ "$addr" = "127.0.0.1" ]; then
		host="127.0.0.1"
	fi

	echo ""
	log "Panel URL: ${scheme}://${host}:${port}${path}"
}

reset_credentials() {
	local user pass salt hash
	user="$(read_tty "New login (leave empty for random 10 chars): " "")"
	[ -z "$user" ] && user="$(random_alnum 10)"
	pass="$(read_tty "New password (leave empty for random 20 chars): " "")"
	[ -z "$pass" ] && pass="$(random_alnum 20)"

	salt="$(od -A n -t x1 -N 16 /dev/urandom | tr -d ' ')"
	hash="$(printf '%s' "${salt}:${pass}" | sha256sum | awk '{print $1}')"

	PANEL_ENV="$REPO_DIR/zanoza-config/panel.env"
	umask 077
	cat > "$PANEL_ENV" <<EOF
ZANOZA_PANEL_USER='${user}'
ZANOZA_PANEL_SALT='${salt}'
ZANOZA_PANEL_PASS_HASH='${hash}'
EOF
	log "Credentials updated."
	log "  Login    : ${user}"
	log "  Password : ${pass}"
	log "Restart the panel to apply: zanoza restart"
}

change_port() {
	local port
	port="$(read_tty "New panel port [8443]: " "8443")"
	if ! [[ "$port" =~ ^[0-9]+$ ]] || [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
		die "Invalid port: $port"
	fi
	set_env_var "ZANOZA_PANEL_PORT" "$port"
	log "Port set to ${port}. Restarting..."
	container_restart
	log "Done."
}

change_path() {
	local p
	p="$(read_tty "New admin path [/admin]: " "/admin")"
	[[ "$p" == /* ]] || p="/${p}"
	set_env_var "ZANOZA_PANEL_PATH" "$p"
	log "Admin path set to ${p}. Restarting..."
	container_restart
	log "Done."
}

set_env_var() {
	local key="$1" val="$2"
	ENV_FILE="$REPO_DIR/.env"
	if [ -f "$ENV_FILE" ]; then
		if grep -q "^${key}=" "$ENV_FILE"; then
			sed -i "s|^${key}=.*|${key}=${val}|" "$ENV_FILE"
		else
			echo "${key}=${val}" >> "$ENV_FILE"
		fi
	else
		echo "${key}=${val}" > "$ENV_FILE"
	fi
}

get_reload_cmd() {
	case "${CONTAINER_RUNTIME}" in
		docker)
			printf 'docker compose -f %s restart' "${COMPOSE_FILE:-$REPO_DIR/docker-compose.yml}"
			;;
		podman)
			printf 'systemctl restart %s' "${UNIT_NAME:-zanoza-panel}"
			;;
		*) echo "true" ;;
	esac
}

reissue_cert() {
	log "Certificate re-issue"
	cat <<EOF

Choose certificate option:
  1) Self-signed IP certificate (6-day, auto-renew)
  2) Let's Encrypt domain certificate
  3) No TLS — panel listens on 127.0.0.1 only
EOF
	local choice
	choice="$(read_tty "Option [1/2/3] (default 1): " "1")"

	CONFIG_DIR="$REPO_DIR/zanoza-config"
	ENV_FILE="$REPO_DIR/.env"

	case "$choice" in
	3)
		set_env_var "ZANOZA_PANEL_ADDR" "127.0.0.1"
		sed -i 's|^ZANOZA_TLS_CERT=|#ZANOZA_TLS_CERT=|' "$ENV_FILE" 2>/dev/null || true
		sed -i 's|^ZANOZA_TLS_KEY=|#ZANOZA_TLS_KEY=|' "$ENV_FILE" 2>/dev/null || true
		rm -f "$CONFIG_DIR/tls.crt" "$CONFIG_DIR/tls.key" "$CONFIG_DIR/.renew-self-signed"
		log "TLS disabled. Panel will listen on 127.0.0.1 only. Access via nginx/SSH tunnel."
		log "Restart the panel to apply: zanoza restart"
		;;
	2)
		local domain reload_cmd
		domain="$(read_tty "Panel domain (A record must point to this server): " "")"
		[ -n "$domain" ] || die "domain is required."
		if ! command -v openssl >/dev/null 2>&1; then
			die "openssl is required for certificate generation."
		fi
		reload_cmd="$(get_reload_cmd)"
		if issue_letsencrypt_cert "$domain" "$CONFIG_DIR/tls.crt" "$CONFIG_DIR/tls.key" "$reload_cmd"; then
			set_env_var "ZANOZA_PANEL_ADDR" "0.0.0.0"
			set_env_var "ZANOZA_TLS_CERT" "/etc/zanoza-panel/tls.crt"
			set_env_var "ZANOZA_TLS_KEY" "/etc/zanoza-panel/tls.key"
			rm -f "$CONFIG_DIR/.renew-self-signed"
			log "Let's Encrypt certificate installed for ${domain}."
		else
			die "Let's Encrypt issuance failed. Check that port 80 is free and the A record points to this server."
		fi
		;;
	*)
			if ! command -v openssl >/dev/null 2>&1; then
				die "openssl is required for certificate generation."
			fi
			local ip
			ip="$(hostname -I 2>/dev/null | tr ' ' '\n' | grep -v '^172\.17\.' | grep -v '^172\.1[89]\.' | grep -v '^172\.2[0-9]\.' | grep -v '^172\.3[01]\.' | head -1)"
			[ -n "$ip" ] || ip="127.0.0.1"
			if generate_self_signed_cert "$CONFIG_DIR/tls.crt" "$CONFIG_DIR/tls.key" "$ip" 6; then
				touch "$CONFIG_DIR/.renew-self-signed"
				set_env_var "ZANOZA_PANEL_ADDR" "0.0.0.0"
				set_env_var "ZANOZA_TLS_CERT" "/etc/zanoza-panel/tls.crt"
				set_env_var "ZANOZA_TLS_KEY" "/etc/zanoza-panel/tls.key"
				log "Self-signed certificate generated for ${ip} (6-day validity, auto-renews daily)."
			else
				die "openssl failed to generate self-signed certificate."
			fi
			;;
	esac
}

# get_reload_cmd() is provided by zanoza-common.sh

restart_panel() {
	log "Restarting..."
	container_restart
	log "Done."
}

view_logs() {
	container_logs
}

update_panel() {
	log "Updating..."
	if [ ! -d "$REPO_DIR/.git" ]; then
		die "not a git repository. Re-run the installer first."
	fi
	local branch
	branch="$(git -C "$REPO_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "main")"
	git -C "$REPO_DIR" pull origin "$branch" || die "git pull failed. Check your network and git remote (expected: origin/${branch})."

	case "${CONTAINER_RUNTIME}" in
		docker)
			docker compose -f "${COMPOSE_FILE}" up -d --build --force-recreate
			;;
		podman)
			container_build
			container_restart
			;;
	esac
	log "Update complete."
}

uninstall_panel() {
	local ans
	ans="$(read_tty "This will stop the panel and remove all container resources. Proceed? [y/N]: " "N")"
	case "$ans" in y|Y) ;; *) die "Aborted.";; esac

	case "${CONTAINER_RUNTIME}" in
		docker)
			container_down
			;;
		podman)
			systemctl stop "${UNIT_NAME}" 2>/dev/null || true
			systemctl disable "${UNIT_NAME}" 2>/dev/null || true
			rm -f /etc/containers/systemd/zanoza-panel.container
			rm -f "/etc/systemd/system/${UNIT_NAME}.service"
			systemctl daemon-reload 2>/dev/null || true
			container_down
			podman rmi zanoza-panel 2>/dev/null || true
			;;
	esac

	CONFIG_DIR="$REPO_DIR/zanoza-config"
	ENV_FILE="$REPO_DIR/.env"

	ans="$(read_tty "Remove config directory (${CONFIG_DIR})? [y/N]: " "N")"
	case "$ans" in y|Y) rm -rf "$CONFIG_DIR" && log "Removed ${CONFIG_DIR}.";; esac

	ans="$(read_tty "Remove .env file (${ENV_FILE})? [y/N]: " "N")"
	case "$ans" in y|Y) rm -f "$ENV_FILE" && log "Removed ${ENV_FILE}.";; esac

	ans="$(read_tty "Remove the zanoza command (/usr/local/bin/zanoza) and install config? [y/N]: " "N")"
	case "$ans" in y|Y)
		rm -f /usr/local/bin/zanoza "$INSTALL_CONF" "$LEGACY_MARKER"
		log "Removed zanoza CLI and config."
		;;
	esac

	log "Uninstall complete. The repository directory (${REPO_DIR}) was not removed — delete it manually if desired."
}

# ==========================================================================
# Menu (interactive, as root)
# ==========================================================================
menu() {
	while true; do
		cat <<EOF

============================================================
  Zanoza Panel (${CONTAINER_RUNTIME}) — Management Menu
============================================================
  1.  Show panel URL
  2.  Reset admin credentials
  3.  Change panel port
  4.  Change admin URL path
  5.  Re-issue / change certificate
  6.  Restart panel
  7.  View logs
  8.  Update panel
  9.  Uninstall panel
  0.  Exit
============================================================
EOF
		local choice="" retries=0
		while [ -z "$choice" ] && [ $retries -lt 10 ]; do
			choice="$(read_tty "Select [0-9]: " "")"
			retries=$((retries + 1))
		done
		[ -z "$choice" ] && { warn "No input received."; continue; }

		case "$choice" in
			1) show_url;;
			2) reset_credentials;;
			3) change_port;;
			4) change_path;;
			5) reissue_cert;;
			6) restart_panel;;
			7) view_logs;;
			8) update_panel;;
			9) uninstall_panel;;
			0) exit 0;;
			*) warn "Invalid choice.";;
		esac
	done
}

# ==========================================================================
# CLI commands (zanoza <command>)
# ==========================================================================
usage() {
	cat <<EOF
zanoza — Zanoza Panel management (${CONTAINER_RUNTIME:-container})

Usage: zanoza [command]

Commands:
  (none)      Interactive menu
  restart     Restart the panel
  logs        View container logs (follow)
  update      Git pull + rebuild + restart
  uninstall   Stop and remove the panel
  --help      This help

EOF
}

main() {
	detect_install

	# Only root or docker-group users can manage containers.
	if [ "$(id -u)" -ne 0 ]; then
		case "${CONTAINER_RUNTIME}" in
			docker)
				if ! docker info >/dev/null 2>&1; then
					die "Cannot access Docker. Run with sudo or add yourself to the docker group."
				fi
				;;
			podman)
				die "Container management requires root. Run with: sudo zanoza ${*:-}"
				;;
		esac
	fi

	case "${1:-}" in
		""|menu)       menu;;
		restart)       restart_panel;;
		logs)          view_logs;;
		update)        update_panel;;
		uninstall)     uninstall_panel;;
		--help|-h)     usage;;
		*)             usage; exit 1;;
	esac
}

main "$@"
